{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Private Ollama on AWS EC2",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen 3 8B on EC2",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "granite4.2:8b": {
          "name": "IBM Granite 4.2 8B on EC2",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
